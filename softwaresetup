Part 1: Day 5 – Helidon SE REST Controller CodeIn Project Spectra's architectural model, lightweight Helidon SE microservices process stateless JSON requests. Below is a complete Java implementation for a modern EmployeeService class that handles routing and consumes JSON payloads emitted by your Day 4 ADF application.EmployeeService.javaSave this file in your project under src/main/java/com/spectra/demo/EmployeeService.java.javapackage com.spectra.demo;

import java.util.logging.Logger;
import io.helidon.common.http.Http;
import io.helidon.webserver.Routing;
import io.helidon.webserver.ServerRequest;
import io.helidon.webserver.ServerResponse;
import io.helidon.webserver.Service;
import jakarta.json.Json;
import jakarta.json.JsonObject;

public class EmployeeService implements Service {

    private static final Logger LOGGER = Logger.getLogger(EmployeeService.class.getName());

    @Override
    public void update(Routing.Rules rules) {
        rules
            .get("/", this::getWelcomeMessage)
            .post("/process-hire", this::processSpectraNewHire);
    }

    /**
     * GET /employee/ - Health check endpoint
     */
    private void getWelcomeMessage(ServerRequest request, ServerResponse response) {
        LOGGER.info("Health check endpoint triggered.");
        JsonObject jsonResponse = Json.createObjectBuilder()
                .add("status", "UP")
                .add("platform", "Project Spectra Core")
                .build();
        response.status(Http.Status.OK_200).send(jsonResponse);
    }

    /**
     * POST /employee/process-hire - Consumes JSON from ADF REST Layer
     */
    private void processSpectraNewHire(ServerRequest request, ServerResponse response) {
        request.content().as(JsonObject.class)
            .thenAccept(jsonPayload -> {
                try {
                    // Extract fields matching standard ADF View Object structures
                    String firstName = jsonPayload.getString("firstName", "Unknown");
                    String lastName = jsonPayload.getString("lastName");
                    double salary = jsonPayload.getJsonNumber("salary").doubleValue();

                    LOGGER.info("Spectra Cloud Engine Processing: " + firstName + " " + lastName);

                    // Mock validation representing BOSS framework logic
                    String systemStatus = (salary < 2000) ? "REJECTED_AUDIT_FAIL" : "APPROVED_PROVISIONED";

                    JsonObject spectraReceipt = Json.createObjectBuilder()
                            .add("transactionId", java.util.UUID.randomUUID().toString())
                            .add("employeeName", firstName + " " + lastName)
                            .add("spectraStatus", systemStatus)
                            .add("timestamp", java.time.Instant.now().toString())
                            .build();

                    response.status(Http.Status.CREATED_201).send(spectraReceipt);

                } catch (Exception e) {
                    JsonObject errorResponse = Json.createObjectBuilder()
                            .add("error", "Invalid BOSS JSON Schema payload: " + e.getMessage())
                            .build();
                    response.status(Http.Status.BAD_REQUEST_400).send(errorResponse);
                }
            })
            .exceptionally(throwable -> {
                response.status(Http.Status.INTERNAL_SERVER_ERROR_500).send(throwable.getMessage());
                return null;
            });
    }
}
Use code with caution.Part 2: Day 6 – CORS Configuration & Server BootstrappingWhen students build pages in ADF or modern UI frames on their Mac machines and make asynchronous JavaScript requests to a Helidon instance running on another port (or your trainer machine IP), browsers block it by default due to Cross-Origin Resource Sharing (CORS) constraints.Below is the orchestration code to bind your EmployeeService, configure a production-ready global CORS filter, and run the server.Main.javaSave this file under src/main/java/com/spectra/demo/Main.java.javapackage com.spectra.demo;

import io.helidon.common.http.Http;
import io.helidon.webserver.Routing;
import io.helidon.webserver.WebServer;
import io.helidon.webserver.cors.CorsSupport;
import io.helidon.webserver.cors.CrossOriginConfig;

public final class Main {

    private Main() { }

    public static void main(final String[] args) {
        // 1. Explicitly configure Cross-Origin rules allowing ADF frontends to talk to Helidon
        CorsSupport corsSupport = CorsSupport.builder()
                .addRule(CrossOriginConfig.builder()
                        .allowOrigins("*") // In production, replace with exact ADF domain/IP
                        .allowMethods("GET", "POST", "PUT", "DELETE", "OPTIONS")
                        .allowHeaders("Content-Type", "Authorization", "X-Requested-With")
                        .exposeHeaders("Location")
                        .allowCredentials(true)
                        .maxAgeAgeSecs(3600)
                        .build())
                .build();

        // 2. Build application routing tables 
        Routing routing = Routing.builder()
                .register(corsSupport) // Apply CORS filter globally to the routing engine
                .register("/employee", new EmployeeService()) // Register our custom endpoint
                .build();

        // 3. Fire up the Helidon Server Sandbox environment
        WebServer server = WebServer.builder(routing)
                .port(8080) // Standard microservices listening port
                .build();

        server.start()
            .thenAccept(ws -> {
                System.out.println("-------------------------------------------------------");
                System.out.println(" SPECTRA MICROSERVICE RUNNING ON: http://localhost:" + ws.port());
                System.out.println(" Test Health check via: GET http://localhost:" + ws.port() + "/employee");
                System.out.println("-------------------------------------------------------");
                ws.whenShutdown().thenRun(() -> System.out.println("Spectra Microservice stopped."));
            })
            .exceptionally(t -> {
                System.err.println("Startup failed: " + t.getMessage());
                return null;
            });
    }
}
