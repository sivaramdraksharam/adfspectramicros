Part 1: The ADF Managed Bean (Invoking the Helidon REST Endpoint)In a corporate production environment, an ADF Managed Bean intercepts user events (like clicking a button on a web page), packages the underlying business data, and transmits it via HTTP to external cloud services.Create this Java class in the View/Controller user interface project (ViewController) inside JDeveloper 14c.HireEmployeeBean.javajavapackage com.adf.view.beans;

import java.io.OutputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.nio.charset.StandardCharsets;
import javax.faces.application.FacesMessage;
import javax.faces.context.FacesContext;
import javax.faces.event.ActionEvent;
import oracle.adf.model.BindingContext;
import oracle.binding.BindingContainer;
import oracle.binding.AttributeBinding;

public class HireEmployeeBean {

    public HireEmployeeBean() {
        super();
    }

    /**
     * Action Listener bound directly to the "Process Spectra Hire" UI Button
     */
    public void handleSpectraOnboarding(ActionEvent actionEvent) {
        FacesContext ctx = FacesContext.getCurrentInstance();
        
        try {
            // 1. Safely extract field values using the ADF Model Binding layer
            BindingContainer bindings = BindingContext.getCurrent().getCurrentBindingsEntry();
            
            AttributeBinding firstNameBind = (AttributeBinding) bindings.get("FirstName");
            AttributeBinding lastNameBind  = (AttributeBinding) bindings.get("LastName");
            AttributeBinding salaryBind    = (AttributeBinding) bindings.get("Salary");

            String firstName = (firstNameBind != null) ? (String) firstNameBind.getInputValue() : "";
            String lastName  = (lastNameBind != null) ? (String) lastNameBind.getInputValue() : "";
            Number salary    = (salaryBind != null) ? (Number) salaryBind.getInputValue() : 0;

            // 2. Programmatically piece together a valid JSON schema payload string
            String jsonPayload = String.format(
                "{\"firstName\":\"%s\",\"lastName\":\"%s\",\"salary\":%s}",
                firstName, lastName, salary.toString()
            );

            // 3. Initiate an HTTP connection to the local Day 5 Helidon Microservice
            URL url = new URL("http://localhost:8080/employee/process-hire");
            HttpURLConnection conn = (HttpURLConnection) url.openConnection();
            conn.setRequestMethod("POST");
            conn.setRequestProperty("Content-Type", "application/json");
            conn.setRequestProperty("Accept", "application/json");
            conn.setDoOutput(true);

            // 4. stream out the payload using Standard UTF-8 byte encoding
            try (OutputStream os = conn.getOutputStream()) {
                byte[] input = jsonPayload.getBytes(StandardCharsets.UTF_8);
                os.write(input, 0, input.length);
            }

            int responseCode = conn.getResponseCode();

            // 5. Present visual toast confirmations back on the ADF Faces screen UI layout
            if (responseCode == HttpURLConnection.HTTP_CREATED) {
                FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_INFO, 
                    "Spectra Success", "Employee safely synchronized with Cloud Core.");
                ctx.addMessage(null, msg);
            } else {
                FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_ERROR, 
                    "Spectra Fail", "Cloud engine rejected request. Status Code: " + responseCode);
                ctx.addMessage(null, msg);
            }

        } catch (Exception e) {
            FacesMessage msg = new FacesMessage(FacesMessage.SEVERITY_FATAL, 
                "Communication Error", "Unable to establish contact with Helidon: " + e.getMessage());
            ctx.addMessage(null, msg);
        }
    }
}
Use code with caution.Part 2: Custom Validation Handlers inside JDeveloper 14cTo catch data structure flaws before sending bad payloads to your Helidon microservice, we implement a declarative custom ADF Business Component Validator. This ensures the data is clean before it ever leaves the Model layer.Step 1: Write the Validation ClassIn your backend Model Project, create a Java class that implements the standard Oracle validation framework interface.javapackage com.adf.model.validators;

import oracle.jbo.rules.JboValidatorInterface;
import oracle.jbo.rules.JboValidatorContext;
import oracle.jbo.ValidationException;

public class EmployeePayloadValidator implements JboValidatorInterface {

    public EmployeePayloadValidator() {
        super();
    }

    /**
     * Executes business-layer validations during Entity object validation phases
     */
    @Override
    public boolean validate(JboValidatorContext ctx) {
        // Access the entity instance currently attempting a transaction save
        Object targetEntity = ctx.getSource();
        
        if (targetEntity != null) {
            try {
                // Example programmatic check: Reflectively evaluate fields
                Object lastName = oracle.jbo.server.ViewRowImpl.class
                    .getMethod("getAttribute", String.class).invoke(targetEntity, "LastName");
                
                if (lastName == null || lastName.toString().trim().isEmpty()) {
                     return false; // Triggers structural transaction failure
                }
            } catch (Exception e) {
                return true; // Pass gracefully if runtime processing reflection fails
            }
        }
        return true;
    }

    @Override
    public String getDescription() {
        return "Guarantees data passes corporate requirements prior to cloud payload assembly.";
    }

    @Override
    public void setDescription(String desc) { }
}


